rules_version = '2';

// Leo Treasurer — Firestore security rules.
// Paste into Firebase Console → Firestore Database → Rules, then Publish.
//
// members/{email}                    { name, position }       committee allow-list (doc id = lower-case email)
// months/{YYYY-MM}                   { openingCash, openingBank, locked }
// months/{YYYY-MM}/transactions/{id} { date, type, account, project, description, ref, amount, hasProof }
// months/{YYYY-MM}/proofs/{id}       { data }  optional proof image for the entry with the same id
//
// Everyone on the committee list can read. Treasurer + assistant treasurers can write.
// Only the Treasurer can finalize/reopen a month and manage the committee list.
service cloud.firestore {
  match /databases/{database}/documents {

    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function memberPath() {
      return /databases/$(database)/documents/members/$(myEmail());
    }
    function isMember() {
      return verified() && exists(memberPath());
    }
    function position() {
      return get(memberPath()).data.position;
    }
    function isSuper() {
      return isMember() && position() == 'super_admin';
    }
    // "Treasurer" powers (finalize months, manage committee) — the Super Admin has them too.
    function isTreasurer() {
      return isMember() && position() in ['super_admin', 'treasurer'];
    }
    function canEdit() {
      return isMember() && position() in ['super_admin', 'treasurer', 'asst_treasurer_1', 'asst_treasurer_2', 'asst_treasurer_3'];
    }
    // Treasurer and assistants may only write to the current month (Sri Lanka time, UTC+5:30).
    // The Super Admin may write to any month (e.g. to enter old records).
    function dateOk(monthId) {
      let now = request.time + duration.value(330, 'm');
      return isSuper() || int(monthId[0:4]) * 12 + int(monthId[5:7]) == now.year() * 12 + now.month();
    }
    function stamped(d) {
      return d.updatedBy == myEmail() && d.updatedAt == request.time;
    }

    // ---- Committee allow-list ----
    match /members/{memberEmail} {
      allow get: if verified() && (memberEmail == myEmail() || isMember());
      allow list: if isMember();
      // Only the Super Admin may create, change or remove a Super Admin entry.
      allow create: if isTreasurer() && validMember(memberEmail, request.resource.data)
        && (isSuper() || request.resource.data.position != 'super_admin');
      allow update: if isTreasurer() && validMember(memberEmail, request.resource.data)
        && (isSuper() || (request.resource.data.position != 'super_admin' && resource.data.position != 'super_admin'));
      allow delete: if isTreasurer() && (isSuper() || resource.data.position != 'super_admin');

      function validMember(id, d) {
        return id == id.lower()
          && d.keys().hasOnly(['name', 'position', 'updatedBy', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.position in ['super_admin', 'president', 'ipp', 'vice_president', 'secretary', 'treasurer',
                            'asst_treasurer_1', 'asst_treasurer_2', 'asst_treasurer_3']
          && stamped(d);
      }
    }

    // ---- Months ----
    match /months/{monthId} {
      allow read: if isMember();
      allow create: if canEdit() && dateOk(monthId)
        && monthId.matches('[0-9]{4}-(0[1-9]|1[0-2])')
        && validMonth(request.resource.data)
        && request.resource.data.locked == false;
      // Assistants may only edit an open month and can't change the lock; the Treasurer can do both.
      // Finalizing/reopening (changing only "locked") is allowed for any month.
      allow update: if canEdit() && validMonth(request.resource.data) && (
          (dateOk(monthId) && (isTreasurer() || (resource.data.locked == false && request.resource.data.locked == false)))
          || (isTreasurer() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['locked', 'updatedBy', 'updatedAt'])));
      allow delete: if false;

      function validMonth(d) {
        return d.keys().hasOnly(['openingCash', 'openingBank', 'locked', 'updatedBy', 'updatedAt'])
          && d.openingCash is number && d.openingBank is number
          && d.locked is bool
          && stamped(d);
      }

      // ---- Cash book entries ----
      match /transactions/{txId} {
        allow read: if isMember();
        allow create: if canEdit() && monthOpen(monthId) && validTx(monthId, request.resource.data)
          && request.resource.data.createdBy == myEmail()
          && request.resource.data.createdAt == request.time;
        allow update: if canEdit() && monthOpen(monthId) && validTx(monthId, request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if canEdit() && monthOpen(monthId);
      }

      // ---- Optional proof image per entry (JPEG data URL, doc id = transaction id) ----
      match /proofs/{txId} {
        allow read: if isMember();
        allow create, update: if canEdit() && monthOpen(monthId)
          && request.resource.data.keys().hasOnly(['data', 'updatedBy', 'updatedAt'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 950000
          && request.resource.data.data.matches('data:image/jpeg;base64,.*')
          && stamped(request.resource.data);
        allow delete: if canEdit() && monthOpen(monthId);
      }

      function monthOpen(id) {
        let path = /databases/$(database)/documents/months/$(id);
        return dateOk(id) && exists(path) && get(path).data.locked == false;
      }

      function validTx(id, d) {
        return d.keys().hasOnly(['date', 'type', 'account', 'project', 'description', 'ref', 'amount', 'hasProof',
                                 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
          && d.date is string && d.date.matches(id + '-[0-3][0-9]')
          && d.type in ['income', 'expense', 'transfer']
          && d.account in ['cash', 'bank']
          && d.project is string && d.project.size() > 0 && d.project.size() <= 120
          && d.description is string && d.description.size() <= 300
          && d.ref is string && d.ref.size() <= 40
          && d.amount is number && d.amount > 0 && d.amount < 100000000
          && (!('hasProof' in d) || d.hasProof is bool)
          && stamped(d);
      }
    }
  }
}
